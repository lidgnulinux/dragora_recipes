# Build recipe for chafa.
#

# Exit immediately on any error
set -e

program=chafa
version=1.14.5
release=0
description="Terminal graphics for the 21st century"
homepage="https://hpjansson.org/chafa"
license="LGPL-3.0-or-later"

tarname=chafa-$version.tar.xz
fetch="https://github.com/hpjansson/chafa/releases/download/$version/$tarname"

build() 
{
	unpack "${tardir}/$tarname"
	
	cd "$srcdir"
	
	# Set sane permissions
	chmod -R u+w,go-w,a+rX-s .

	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var \
		--disable-gtk-doc \
		--without-imagemagick

	make 
	make DESTDIR="$destdir" install 
}
