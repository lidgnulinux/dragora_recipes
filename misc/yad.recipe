# Build recipe for yad.
#

# Exit immediately on any error
set -e

program=yad
version=14.1
release=0
description="Fork of zenity - display graphical dialogs from shell scripts or command line"
homepage="https://sourceforge.net/projects/yad-dialog/"
license="GPL-3.0-or-later"

tarname=yad-$version.tar.xz
fetch="https://github.com/v1cont/yad/releases/download/v$version/$tarname"

srcdir=

build() 
{
	unpack "${tardir}/$tarname"
	
	cd "$srcdir"
	
	# Set sane permissions
	chmod -R u+w,go-w,a+rX-s .

	# autoreconf -vif
	./configure \
		--prefix=/usr \
		--enable-icon-browser \
		--enable-html

	make -j2 
	make DESTDIR="$destdir" install 
}
