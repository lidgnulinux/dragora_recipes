# Build recipe for xfce4-whiskermenu-plugin.
#

# Exit immediately on any error
set -e

program=xfce4-whiskermenu-plugin
version=2.8.3
release=3
description="Whisker menu plugin for xfce4-panel."
homepage="https://docs.xfce.org/panel-plugins/xfce4-whiskermenu-plugin/start"
license="GNU General Public License v2.0 or later"

tarname=xfce4-whiskermenu-plugin-v2.8.3.tar.gz
fetch="https://gitlab.xfce.org/panel-plugins/xfce4-whiskermenu-plugin/-/archive/v2.8.3/$tarname"
srcdir=xfce4-whiskermenu-plugin-v2.8.3

build() 
{
	unpack "${tardir}/$tarname"
	
	cd "$srcdir"
	
	# Set sane permissions
	chmod -R u+w,go-w,a+rX-s .

	cmake -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR='lib'
	cmake --build build

	DESTDIR="$destdir" cmake --install build
}
