# Build recipe for xfce4-pulseaudio-plugin.
#

# Exit immediately on any error
set -e

program=xfce4-pulseaudio-plugin
version=0.4.9
release=0
description="Pulseaudio plugin for xfce4."
homepage="https://archive.xfce.org/src/panel-plugins/xfce4-pulseaudio-plugin"
license="GPL-2.0-only"

tarname=$program-$version.tar.bz2
fetch="https://archive.xfce.org/src/panel-plugins/xfce4-pulseaudio-plugin/0.4/$tarname"

build() 
{
	unpack "${tardir}/$tarname"
	
	cd "$srcdir"
	
	# Set sane permissions
	chmod -R u+w,go-w,a+rX-s .

	autoreconf -vif
	./configure \
		--disable-static \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--prefix=/usr

	make 
	make DESTDIR="$destdir" install 
}
